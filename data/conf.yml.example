debug: true
enabletrustedproxycheck: false
trustedproxies:
  - 192.168.160.1
proxyheader: X-Forwarded-For
database: postgres://solitudes:thisispassword@db/solitudes?sslmode=disable

site:
  spacename: Solitudes
  spacedesc: We love writing
  domain: blog.example.com # Public HTTPS host; required for OIDC and verification links.
# Email/password registration requires SMTP. Optional upstream providers and
# WebAuthn are configured under auth; see README.md for the full example.
